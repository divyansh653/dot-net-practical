@model List<ReservationViewModel>
@{
    ViewData["Title"] = "Reservations";
}

<h1>Reservations</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Add Reservation</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Customer Id</th>
            <th>Check-in</th>
            <th>Check-out</th>
            <th>Guests</th>
            <th>Rooms</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reservation in Model)
        {
            <tr>
                <td>@reservation.Id</td>
                <td>@reservation.CustomerId</td>
                <td>@reservation.Check_In_Date.ToString("yyyy-MM-dd")</td>
                <td>@reservation.Check_Out_Date.ToString("yyyy-MM-dd")</td>
                <td>@reservation.No_Guest</td>
                <td>@(reservation.ReservationRooms?.Count ?? 0)</td>
                <td>@reservation.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
